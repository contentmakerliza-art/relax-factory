[Unit]
Description=Quiet Pines Cabin remaining previews through December 22
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/relax-codex
ExecStart=/usr/bin/python3 /opt/relax-codex/cabin-backlog/run-batch.py
MemoryMax=256M
CPUQuota=20%
RuntimeMaxSec=172800
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
